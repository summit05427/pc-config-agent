# =============================================================
# Monorepo 统一环境变量示例
# 使用方式：复制为 .env（已被 .gitignore 忽略），再替换所有 replace-with-* 值
# 安全约定：.env 只存在于部署机，禁止提交；生产密钥用密码管理器生成
# =============================================================

# ---------- Compose ----------
# 同一台机器并行运行多套项目时，此名必须唯一：
# 它决定容器名前缀、数据卷前缀与网络名，重名会导致两套项目互相接管
COMPOSE_PROJECT_NAME=pc-config-advisor
# 本地构建镜像的仓库前缀，决定 tag 为 pc-config-advisor/frontend:local 等；
# 同时部署多套项目时不得复用同一个值，否则 --build 会互相覆盖镜像
IMAGE_PREFIX=pc-config-advisor

# ---------- 业务数据库（Java / PostgreSQL） ----------
POSTGRES_USER=agent
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=agent

# ---------- Agent 会话库（pgvector / PostgreSQL） ----------
AGENT_POSTGRES_USER=agent
AGENT_POSTGRES_PASSWORD=replace-with-strong-agent-db-password
AGENT_POSTGRES_DB=agent_service

# ---------- Redis（Agent 服务使用） ----------
# 密码会拼进 redis:// 连接串，含 @ : / # 等特殊字符时必须做 URL 编码
REDIS_PASSWORD=replace-with-strong-redis-password

# ---------- JWT（RS256 非对称：Java 持私钥签发，Agent 只用公钥验签） ----------
# 生成方式：
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# 填入 .env 时把 PEM 压成单行、换行写成字面量 \n（代码会自动还原），例如：
#   JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----"
# 公钥可以公开，私钥只允许配置在本服务；Agent 不配置私钥。
JWT_PRIVATE_KEY="replace-with-pkcs8-private-key-pem"
JWT_PUBLIC_KEY="replace-with-x509-public-key-pem"
# 密钥标识写入 JWS Header，轮换时 Agent 按 kid 选择公钥
JWT_KID=rsa-2026-10
JWT_ISSUER=agent-application-service
# Java 与 Agent 必须一致，否则两端验签失败
JWT_AUDIENCE=agent-clients
# 访问令牌有效期：前端已接入自动刷新，保持短令牌降低泄露窗口
JWT_ACCESS_TTL=10m

# ---------- Refresh Token（不透明随机串，只经 HttpOnly Cookie 下发） ----------
# 闲置 7 天未使用即失效；自登录起 30 天为绝对上限，刷新不会延长
AUTH_REFRESH_IDLE_TTL=7d
AUTH_REFRESH_ABSOLUTE_TTL=30d
# 轮换宽限期：并发刷新时旧令牌在此窗口内只返回 401，不判定为重放撤销整族
AUTH_REFRESH_ROTATION_GRACE=60s
# 刷新 Cookie 的 Secure 属性；生产必须为 true（ProdConfigGuard 会拒绝启动），
# 仅本地 http 调试且 profile 非 prod 时才允许 false
AUTH_COOKIE_SECURE=true

# ---------- 临时引导账号（首次启动且用户名不存在时创建；口令留空则不创建） ----------
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=replace-with-strong-admin-password
AUTH_ADMIN_ROLES=ADMIN
# demo 账号仅建议本地/预发启用；生产留空即不创建
AUTH_DEMO_USERNAME=demo
AUTH_DEMO_PASSWORD=
AUTH_DEMO_ROLES=USER

# ---------- 跨域 ----------
# 前后端同源部署时留空即可；前后端分域时填前端域名，多个用英文逗号分隔
CORS_ALLOWED_ORIGINS=

# ---------- 模型运行时控制面（Java） ----------
# 总开关：关闭时 /internal/v1/** 与 /api/v1/models 返回 404，回退到 Agent 原有单例逻辑
MODEL_RUNTIME_ENABLED=false
# BYOK（用户自带密钥）开关；必须同时开启 MODEL_RUNTIME_ENABLED，否则启动失败
BYOK_ENABLED=false
# BYOK 凭证加密主密钥（32 字节 base64，可用 `openssl rand -base64 32` 生成）
# 启用 BYOK 时必填且不得使用占位值；只注入 Java，禁止下发给 Agent 或前端
# 丢失主密钥等于全部已保存凭证不可用，必须与数据库备份分开保管
MODEL_CRED_MASTER_KEY=
# 新密文使用的密钥版本；轮换主密钥时递增，旧版本密文仍可解密
MODEL_CRED_KEY_VERSION=1
# 多版本主密钥环，格式 <version>:<base64>，多项英文逗号分隔；用于轮换后继续解密旧密文
# 配置后按密文版本选密钥；未配置时退回单密钥 MODEL_CRED_MASTER_KEY，且必须包含 MODEL_CRED_KEY_VERSION
MODEL_CRED_MASTER_KEYS=
# 凭证真实远程验证超时（Java 调用 Provider 的 GET /models 或最小 chat 探测）
MODEL_CRED_VERIFY_TIMEOUT=5s
# 单用户每分钟手动验证次数上限；超限返回 429（验证会发起真实出站请求，不能无限调用）
MODEL_CRED_VERIFY_RATE_LIMIT_PER_MINUTE=5
# Provider 默认接入地址与探测模型已移交 LiteLLM：见 deploy/litellm/config.yaml
# Auto 对应的平台默认模型，格式 <provider>:<modelKey>
MODEL_DEFAULT_KEY=deepseek:deepseek-v4-pro
# 运行时任务有效期：过期后不可再读取或兑换凭证；同时是任务幂等窗口
MODEL_TASK_TTL=10m
# 过期任务清理开关：只把 ACTIVE 且已到期的任务置为 EXPIRED，不物理删除（用量明细仍引用任务行）
MODEL_TASK_CLEANUP_ENABLED=true
# 清理 cron，按 UTC 计算；默认每小时整点
MODEL_TASK_CLEANUP_CRON="0 0 * * * *"
# 每用户每日请求额度（产品配置，切换次日生效；不是 Provider 费用额度）
MODEL_QUOTA_DAILY_REQUESTS=100
# 定时对账开关：只读统计前一 UTC 自然日的额度溢出、归属不一致与负数费用，不修改台账
MODEL_RECONCILE_ENABLED=true
# 对账 cron，按 UTC 计算；默认每日 00:05 对账前一自然日（触发时当日数据尚未产生）
MODEL_RECONCILE_CRON="0 5 0 * * *"
# Agent 换取服务令牌的 client 凭据；启用 MODEL_RUNTIME_ENABLED 时 secret 必填
# 生产（prod）下必须替换为不少于 16 字符的强随机口令，占位值会阻止应用启动
INTERNAL_AUTH_CLIENT_ID=agent-service
INTERNAL_AUTH_CLIENT_SECRET=replace-with-strong-internal-client-secret
# 服务令牌有效期，短令牌降低泄露窗口
INTERNAL_AUTH_TOKEN_TTL=5m

# ---------- 大模型 ----------
# 模型统一走 LiteLLM 网关：模型标识即网关 model_list 中的 model_name
LLM_MODEL=deepseek:deepseek-v4-pro
# 宿主机直跑 Agent 时使用；容器内由 compose 固定为 http://litellm:4000
LLM__GATEWAY_BASE_URL=http://127.0.0.1:4000
# 必须与 LITELLM_MASTER_KEY 一致；留空则退化为直连模式（仅 Solo 使用）
LLM__GATEWAY_API_KEY=sk-replace-with-strong-litellm-master-key
# 容器内覆盖 Agent 的网关密钥：不填则继承 LITELLM_MASTER_KEY；Solo 必须显式置空以强制直连
LLM_GATEWAY_API_KEY=
# 直连模式（Solo）专用：没有网关时的平台密钥与接入地址
LLM_API_KEY=sk-replace-with-your-real-key
LLM_BASE_URL=https://api.deepseek.com/v1
# 单次生成的 token 上限；联调或降本时可调小，默认 2048
LLM_MAX_TOKENS=2048

# ---------- 模型网关（LiteLLM，唯一模型出口） ----------
# 管理口令：只有 Agent 持有；生产必须替换为不少于 32 字符的强随机值
LITELLM_MASTER_KEY=sk-replace-with-strong-litellm-master-key
# 网关内部加密用盐：一旦设置不可更改，否则已加密字段无法解密
LITELLM_SALT_KEY=replace-with-strong-litellm-salt-key
# 只绑定回环地址，容器间走 Compose 服务名 litellm:4000
LITELLM_PORT=4000
# 宿主机直跑 Java 时使用；容器内由 compose 注入，且必须与 LITELLM_MASTER_KEY 一致
MODEL_GATEWAY_BASE_URL=http://127.0.0.1:4000
MODEL_GATEWAY_MASTER_KEY=sk-replace-with-strong-litellm-master-key
# 非默认 provider 的密钥；留空表示不启用该 provider（deepseek 复用 LLM_API_KEY）
OPENAI_API_KEY=
QWEN_API_KEY=
VOLCENGINE_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- 统一观测（Prometheus） ----------
# 只做指标汇聚：抓取 Java /actuator/prometheus、Agent /api/v1/metrics、LiteLLM /metrics/
# master key 由 Compose 在启动时写入容器内临时文件，不落在配置文件里
PROMETHEUS_PORT=9090

# ---------- 生成式 UI（Agent 侧） ----------
# 与前端 VITE_OPENUI_ENABLED 必须同步开启；开启后 Agent 注入 OpenUI 组件契约
OPENUI_ENABLED=false

# ---------- MCP 接入（Agent 侧，可选） ----------
# 仅支持网关拓扑：Server 清单在 deploy/litellm/config.yaml 的 mcp_servers
# Solo 模式没有网关，因此不提供 MCP；默认关闭，不发起任何连接
MCP_ENABLED=false
# 留空则由 LLM__GATEWAY_BASE_URL + /mcp 推导
MCP_GATEWAY_URL=
# 只暴露列出的工具（网关返回的原始工具名，JSON 数组）；为空表示全部
MCP_ALLOWED_TOOLS=[]

# ---------- HITL 人在回路（Agent 侧，默认关闭） ----------
# 开启后缺关键槽位或兼容性无法确认时暂停提问；必须配合 postgres 后端，memory 后端开启即拒绝启动
HITL_ENABLED=false
# 中断有效期（秒，1-86400），超时后恢复请求返回 interrupt_expired
HITL_INTERRUPT_TTL_SECONDS=1800

# ---------- 可选 RAG（Agent 侧，默认关闭） ----------
# 默认关闭：不导入检索器模块、不发起外部请求；开启后必须配置检索器模块，否则拒绝启动
RAG_ENABLED=false
# 检索器模块点分路径，模块内必须暴露 create_retriever()
RAG_RETRIEVER_MODULE=
# 单轮检索返回的引用条数上限（1-20）
RAG_TOP_K=5

# ---------- 输入侧护栏（Agent 侧，默认开启） ----------
# 命中超长、控制字符、零宽字符或高置信度提示词注入时直接返回 422 input_rejected
GUARD_ENABLED=true
# 单条用户输入字符上限（1-20000），与 ChatRequest.message 的校验上限对齐
GUARD_MAX_INPUT_CHARS=4000
# 关闭后仅保留长度与字符类校验，疑似注入放行（仅用于灰度对比）
GUARD_BLOCK_ON_INJECTION=true

# ---------- 对话限流（Agent 侧，默认开启） ----------
# 按登录用户做 Redis 固定窗口计数；0 表示只保留配置位、不计数
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=20
# 窗口长度（秒，10-3600）
RATE_LIMIT_WINDOW_SECONDS=60
# Redis 不可用时是否放行：true 为降级放行（fail-open）
RATE_LIMIT_FAIL_OPEN=true

# ---------- 前端构建参数（会被打进静态产物，禁止放密钥） ----------
VITE_APP_TITLE=PC Build Agent
VITE_API_BASE_URL=/api/v1
VITE_AGENT_BASE_URL=/agent/api/v1
# 生成式 UI 开关：与 Agent 的 OPENUI_ENABLED 必须同步开启
VITE_OPENUI_ENABLED=false

# ---------- 管理端（admin） ----------
# 浏览器标题；访问路径固定为 /admin/，无需额外配置
ADMIN_APP_TITLE=Agent 管理后台

# ---------- 数据治理脚本（scripts/data-cleaning） ----------
# DeepSeek 官方 Search API Key，仅脚本使用，禁止进入前端产物
DEEPSEEK_API_KEY=
# 京东联盟应用凭证；数据限推广用途，未配置时 Stage 3D 只做配置探测
JD_UNION_APP_KEY=
JD_UNION_APP_SECRET=
JD_UNION_SITE_ID=
JD_UNION_ACCESS_TOKEN=
