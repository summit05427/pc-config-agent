{
  "version": 1,
  "description": "跨端配置契约：唯一真源是根 .env；agent-service/.env 与 frontend/.env 的托管块由 generate-config.ps1 派生，不得手改。",
  "files": {
    "root": ".env",
    "agent": "agent-service/.env",
    "frontend": "frontend/.env",
    "example": ".env.example"
  },
  "ports": [
    "WEB_PORT",
    "BACKEND_PORT",
    "AGENT_PORT",
    "POSTGRES_PORT",
    "AGENT_POSTGRES_PORT",
    "REDIS_PORT",
    "LITELLM_PORT",
    "PROMETHEUS_PORT"
  ],
  "placeholderMarkers": [
    "replace-with",
    "changeme",
    "ci-only"
  ],
  "required": [
    { "file": "root", "key": "COMPOSE_PROJECT_NAME", "pattern": "^[a-z0-9][a-z0-9_-]*$", "message": "非法项目名会与其它项目共用容器与数据卷" },
    { "file": "root", "key": "IMAGE_PREFIX", "message": "缺失会让 --build 覆盖基线项目镜像" },
    { "file": "root", "key": "POSTGRES_USER" },
    { "file": "root", "key": "POSTGRES_PASSWORD" },
    { "file": "root", "key": "POSTGRES_DB" },
    { "file": "root", "key": "AGENT_POSTGRES_USER" },
    { "file": "root", "key": "AGENT_POSTGRES_PASSWORD" },
    { "file": "root", "key": "AGENT_POSTGRES_DB" },
    { "file": "root", "key": "REDIS_PASSWORD" },
    { "file": "root", "key": "JWT_KID" },
    { "file": "root", "key": "JWT_ISSUER" },
    { "file": "root", "key": "JWT_AUDIENCE" },
    { "file": "root", "key": "JWT_PRIVATE_KEY", "pem": "PRIVATE KEY" },
    { "file": "root", "key": "JWT_PUBLIC_KEY", "pem": "PUBLIC KEY" },
    { "file": "root", "key": "AUTH_ADMIN_USERNAME" },
    { "file": "root", "key": "AUTH_ADMIN_PASSWORD", "minLength": 8 },
    { "file": "root", "key": "INTERNAL_AUTH_CLIENT_ID" },
    { "file": "root", "key": "INTERNAL_AUTH_CLIENT_SECRET", "minLength": 8 }
  ],
  "booleans": [
    "BYOK_ENABLED",
    "MODEL_RUNTIME_ENABLED",
    "OPENUI_ENABLED",
    "MULTI_AGENT_ENABLED",
    "CRITIC_ENABLED",
    "SUMMARY_ENABLED",
    "MCP_ENABLED",
    "RAG_ENABLED",
    "HITL_ENABLED"
  ],
  "enums": [
    { "key": "SPRING_PROFILES_ACTIVE", "allowed": ["local", "dev", "test", "prod"], "files": ["root"] },
    { "key": "APP_ENV", "allowed": ["dev", "staging", "prod"], "files": ["root", "agent"] },
    { "key": "STORAGE__BACKEND", "allowed": ["memory", "postgres"], "files": ["agent"] }
  ],
  "contracts": [
    { "name": "JWT KID", "left": "JWT_KID", "right": "AUTH__JWT_KID" },
    { "name": "JWT 公钥", "left": "JWT_PUBLIC_KEY", "right": "AUTH__JWT_PUBLIC_KEY", "ignoreWhitespace": true },
    { "name": "JWT 签发方", "left": "JWT_ISSUER", "right": "AUTH__ISSUER" },
    { "name": "JWT 受众", "left": "JWT_AUDIENCE", "right": "AUTH__AUDIENCE" },
    { "name": "模型运行时开关", "left": "MODEL_RUNTIME_ENABLED", "right": "MODEL_RUNTIME__ENABLED" },
    { "name": "OpenUI 开关", "left": "OPENUI_ENABLED", "right": "OPENUI__ENABLED", "thirdFile": "frontend", "third": "VITE_OPENUI_ENABLED" },
    { "name": "MCP 开关", "left": "MCP_ENABLED", "right": "MCP__ENABLED" },
    { "name": "RAG 开关", "left": "RAG_ENABLED", "right": "RAG__ENABLED" },
    { "name": "HITL 开关", "left": "HITL_ENABLED", "right": "HITL__ENABLED" }
  ],
  "templates": [
    {
      "name": "控制面地址",
      "file": "agent",
      "key": "CONTROL_PLANE__BASE_URL",
      "template": "http://127.0.0.1:{BACKEND_PORT}"
    },
    {
      "name": "Redis 连接串",
      "file": "agent",
      "key": "REDIS__URL",
      "template": "redis://:{REDIS_PASSWORD}@127.0.0.1:{REDIS_PORT}/0"
    },
    {
      "name": "Agent 会话库连接串",
      "file": "agent",
      "key": "STORAGE__POSTGRES_URL",
      "template": "postgresql://{AGENT_POSTGRES_USER}:{AGENT_POSTGRES_PASSWORD}@127.0.0.1:{AGENT_POSTGRES_PORT}/{AGENT_POSTGRES_DB}"
    },
    {
      "name": "LLM 网关地址",
      "file": "agent",
      "key": "LLM__GATEWAY_BASE_URL",
      "template": "http://127.0.0.1:{LITELLM_PORT}"
    }
  ],
  "derived": {
    "agent": [
      { "key": "AUTH__JWT_PUBLIC_KEY", "from": "JWT_PUBLIC_KEY" },
      { "key": "AUTH__JWT_KID", "from": "JWT_KID" },
      { "key": "AUTH__ISSUER", "from": "JWT_ISSUER" },
      { "key": "AUTH__AUDIENCE", "from": "JWT_AUDIENCE" },
      { "key": "LLM__API_KEY", "from": "LLM_API_KEY" },
      { "key": "LLM__BASE_URL", "from": "LLM_BASE_URL" },
      { "key": "LLM__MODEL", "from": "LLM_MODEL" },
      { "key": "LLM__MAX_TOKENS", "from": "LLM_MAX_TOKENS" },
      { "key": "LLM__GATEWAY_BASE_URL", "template": "http://127.0.0.1:{LITELLM_PORT}" },
      { "key": "LLM__GATEWAY_API_KEY", "from": "LITELLM_MASTER_KEY" },
      { "key": "STORAGE__POSTGRES_URL", "template": "postgresql://{AGENT_POSTGRES_USER}:{AGENT_POSTGRES_PASSWORD}@127.0.0.1:{AGENT_POSTGRES_PORT}/{AGENT_POSTGRES_DB}" },
      { "key": "REDIS__URL", "template": "redis://:{REDIS_PASSWORD}@127.0.0.1:{REDIS_PORT}/0" },
      { "key": "REDIS__REQUIRED", "const": "true" },
      { "key": "CONTROL_PLANE__BASE_URL", "template": "http://127.0.0.1:{BACKEND_PORT}" },
      { "key": "CONTROL_PLANE__CLIENT_ID", "from": "INTERNAL_AUTH_CLIENT_ID" },
      { "key": "CONTROL_PLANE__CLIENT_SECRET", "from": "INTERNAL_AUTH_CLIENT_SECRET" },
      { "key": "MODEL_RUNTIME__ENABLED", "from": "MODEL_RUNTIME_ENABLED" },
      { "key": "OPENUI__ENABLED", "from": "OPENUI_ENABLED" },
      { "key": "AGENT__MULTI_AGENT_ENABLED", "from": "MULTI_AGENT_ENABLED" },
      { "key": "AGENT__CRITIC_ENABLED", "from": "CRITIC_ENABLED" },
      { "key": "AGENT__SUMMARY_ENABLED", "from": "SUMMARY_ENABLED" },
      { "key": "AGENT__SUMMARY_TRIGGER_TOKENS", "from": "SUMMARY_TRIGGER_TOKENS" },
      { "key": "HITL__ENABLED", "from": "HITL_ENABLED" },
      { "key": "RAG__ENABLED", "from": "RAG_ENABLED" },
      { "key": "RAG__RETRIEVER_MODULE", "from": "RAG_RETRIEVER_MODULE" },
      { "key": "RAG__TOP_K", "from": "RAG_TOP_K" },
      { "key": "RAG__MIN_RELEVANCE_SCORE", "from": "RAG_MIN_RELEVANCE_SCORE" },
      { "key": "RAG__EMBEDDING_MODEL", "from": "RAG_EMBEDDING_MODEL" },
      { "key": "RAG__EMBEDDING_DIMENSIONS", "from": "RAG_EMBEDDING_DIMENSIONS" },
      { "key": "RAG__EMBEDDING_BATCH_SIZE", "from": "RAG_EMBEDDING_BATCH_SIZE" },
      { "key": "MCP__ENABLED", "from": "MCP_ENABLED" },
      { "key": "MCP__GATEWAY_URL", "from": "MCP_GATEWAY_URL" },
      { "key": "MCP__ALLOWED_TOOLS", "from": "MCP_ALLOWED_TOOLS" },
      { "key": "CORS_ORIGINS", "const": "[\"http://localhost:5273\",\"http://127.0.0.1:5273\"]" }
    ],
    "frontend": [
      { "key": "VITE_APP_TITLE", "from": "VITE_APP_TITLE" },
      { "key": "VITE_APP_ENV", "const": "development" },
      { "key": "VITE_API_BASE_URL", "from": "VITE_API_BASE_URL" },
      { "key": "VITE_AGENT_BASE_URL", "from": "VITE_AGENT_BASE_URL" },
      { "key": "VITE_API_TIMEOUT", "const": "10000" },
      { "key": "VITE_USE_MOCK", "const": "false" },
      { "key": "VITE_OPENUI_ENABLED", "from": "VITE_OPENUI_ENABLED" }
    ]
  }
}
