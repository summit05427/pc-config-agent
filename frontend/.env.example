# 复制为 .env.local 使用，不要把真实密钥提交到仓库
# VITE_ 前缀的变量会打包进前端产物，禁止写入密钥、Token、内网地址

# 应用标题，会注入 index.html 的 <title>
VITE_APP_TITLE=PC Build Agent
# 当前环境，可选值 development / production
VITE_APP_ENV=development
# 接口基础地址，需包含版本前缀；本地 `pnpm dev` 由 Vite 代理 /api 到 18080，保持相对路径才能带上刷新 Cookie
VITE_API_BASE_URL=/api/v1
# Agent 接口基础地址，经 Nginx 或本地 Vite 代理的 /agent 转发；如需绕过代理直连，可改为 http://localhost:18000/api/v1（跨源时刷新 Cookie 不会生效）
VITE_AGENT_BASE_URL=/agent/api/v1
# 请求超时时间，单位毫秒
VITE_API_TIMEOUT=10000
# 是否启用 Mock 数据
VITE_USE_MOCK=false
# 是否启用生成式 UI（OpenUI）；默认关闭，关闭时聊天仍按普通 Markdown 渲染
VITE_OPENUI_ENABLED=false
