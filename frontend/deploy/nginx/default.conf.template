# 该文件由 nginx 官方镜像的 20-envsubst-on-templates.sh 在容器启动时渲染。
# 只替换容器中已定义的环境变量（${BACKEND_UPSTREAM}、${AGENT_UPSTREAM}、${ADMIN_UPSTREAM}），
# nginx 自身的 $uri、$host、$http_upgrade 等变量不会被替换。
#
# 注意（BUG-04）：proxy_pass 的主机名在 Nginx 启动时解析并缓存到 worker 生命周期内。
# docker compose 重建 application-service、agent-service 或 admin 后容器 IP 会变化，
# 必须执行 `docker compose restart frontend` 刷新解析结果，否则 /api/、/agent/ 与 /admin/
# 会持续返回 502，直到前端容器重启。

# WebSocket 升级：客户端带 Upgrade 头时转发 upgrade，否则保持连接语义
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # 上传类接口的体积上限，按业务需要调整
    client_max_body_size 20m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json application/xml
        image/svg+xml font/woff2;

    # 基础安全响应头；注意：location 内一旦自定义 add_header，就不再继承这里的配置
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # 容器健康检查
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Vite 构建产物带内容 hash，文件名变化即 URL 变化，可长期缓存
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        access_log off;
        try_files $uri =404;
    }

    # 入口 HTML 不缓存，保证发布后立即拿到新的资源引用
    location = /index.html {
        expires -1;
    }

    # TanStack Router 使用 history 模式，刷新子路由时回退到 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 业务后端：proxy_pass 不带 URI，因此保留 /api/ 前缀（后端接口本身即 /api/v1/...）
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # 管理端静态站点：/admin/ 前缀在这里剥掉，admin 容器内的 nginx 按根路径提供文件。
    # 管理端产物以 /admin/ 为 base，因此浏览器请求 /admin/assets/... 会命中这里。
    location = /admin {
        return 301 /admin/;
    }

    location /admin/ {
        proxy_pass ${ADMIN_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # 指标端点只允许内网/本机访问：Prometheus 抓取走容器网络，
    # 公网请求在网关层直接 403，不进入 Agent。
    location = /agent/api/v1/metrics {
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
        access_log off;
        proxy_pass ${AGENT_UPSTREAM}/api/v1/metrics;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        gzip off;
    }

    # Agent 流式接口：/agent/api/v1/chat/stream -> ${AGENT_UPSTREAM}/api/v1/chat/stream
    # proxy_pass 末尾的 "/" 会剥掉 /agent 前缀，保留后续的 /api/v1/...
    location /agent/ {
        proxy_pass ${AGENT_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $http_x_request_id;
        # SSE 不需要复用升级连接，显式清空避免上游误判为 WebSocket
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        # SSE 是长连接，读取/发送超时需放宽到 1 小时
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        # 关闭缓冲与压缩，保证事件逐条实时下发
        proxy_buffering off;
        proxy_cache off;
        gzip off;
    }
}
