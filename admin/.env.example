# 管理端前端配置（Vite 在构建期写入静态文件，修改后必须重新构建）

# 页面标题，显示在浏览器标签与侧边栏
VITE_APP_TITLE=Agent 管理后台

# 接口基地址：开发环境走 Vite 代理，生产由 Nginx 同域转发到 application-service
VITE_API_BASE_URL=/api/v1

# 部署前缀：本地开发保持 /；生产镜像由 Compose 传 /admin/，必须与 Nginx 代理前缀一致
VITE_BASE_PATH=/

# 仅本地开发代理目标，不参与客户端构建产物
VITE_API_PROXY_TARGET=http://localhost:18080
