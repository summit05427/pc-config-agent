# =============================================================
# 部署目录环境变量示例
# 实际使用时推荐直接复用仓库根目录的 .env：
#   docker compose -f deploy/docker-compose.infra.yml --env-file .env up -d
# 本文件仅用于说明变量名，禁止填写真实口令后提交。
# =============================================================

COMPOSE_PROJECT_NAME=agent-project-template
POSTGRES_USER=agent
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=agent
AGENT_POSTGRES_USER=agent
AGENT_POSTGRES_PASSWORD=replace-with-strong-agent-db-password
AGENT_POSTGRES_DB=agent_service
REDIS_PASSWORD=replace-with-strong-redis-password
