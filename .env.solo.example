# Solo 模式：只启动 Agent（memory 存储、无 Redis、不依赖 Java / 中间件）
# 使用方式：
#   1. uv --directory agent-service run python ../scripts/generate_solo_env.py
#   2. 编辑 .env.solo，把 LLM_API_KEY 换成真实密钥
#   3. docker compose --env-file .env.solo up -d --build agent-service
# 本文件只含占位符，真实密钥由脚本写入 .env.solo（已被 .gitignore 忽略）

# Solo 使用独立的 Compose 项目名，避免与完整模式或同机其它项目共用容器名
COMPOSE_PROJECT_NAME=pc-config-advisor-solo
# 镜像前缀与完整模式共用本项目前缀，但仍与同机其它项目区分
IMAGE_PREFIX=pc-config-advisor
APP_ENV=dev
AGENT_DEBUG=true
AGENT_PORT=8000

# Solo 存储：进程内存，重启即丢；生产请改用完整模式
AGENT_STORAGE_BACKEND=memory
AGENT_STORAGE_POSTGRES_URL=

# Solo 不启用 Redis；空 URL + required=false 即可关闭
AGENT_REDIS_REQUIRED=false
AGENT_REDIS_URL=

# Compose 会对文件内所有服务做变量插值，即使其 profile 未启用；
# 下列变量仅用于让完整模式服务通过插值校验，不会被 Solo 启动。
POSTGRES_USER=solo-unused
POSTGRES_PASSWORD=solo-unused
POSTGRES_DB=solo-unused
AGENT_POSTGRES_USER=solo-unused
AGENT_POSTGRES_PASSWORD=solo-unused
AGENT_POSTGRES_DB=solo-unused
REDIS_PASSWORD=solo-unused
JWT_PRIVATE_KEY=solo-unused
# 契约型变量在完整编排中已改为必填；Solo 只启动 Agent，这里仅用于通过插值校验
JWT_KID=rsa-dev
JWT_ISSUER=agent-application-service
JWT_AUDIENCE=agent-clients
SPRING_PROFILES_ACTIVE=prod
AUTH_COOKIE_SECURE=true
BYOK_ENABLED=false
OPENUI_ENABLED=false
HITL_ENABLED=false
# Solo 用 memory 存储，RAG 必须关闭（内置检索器要求 postgres）
RAG_ENABLED=false
AUTH_ADMIN_PASSWORD=solo-unused
# LiteLLM 与 Prometheus 在完整模式下强制校验这两个变量；Solo 不启动它们，仅用于满足插值
LITELLM_MASTER_KEY=solo-unused
LITELLM_SALT_KEY=solo-unused
# 即使不启动网关，也要与宿主已占用端口错开，避免后续切回完整模式时冲突
LITELLM_PORT=14000
PROMETHEUS_PORT=19090
# Solo 必须显式置空：否则 Agent 会继承 master key 并尝试连接未启动的 LiteLLM
LLM_GATEWAY_API_KEY=

# 本地自签密钥由 scripts/generate_solo_env.py 注入
AUTH_DEV_KID=rsa-dev
AUTH_DEV_PRIVATE_KEY="__DEV_PRIVATE_KEY__"
JWT_PUBLIC_KEY="__DEV_PUBLIC_KEY__"

# 模型：Solo 不启用控制面，直接使用下面这把平台密钥（无网关，直连模式）
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=sk-replace-with-your-real-key
LLM_BASE_URL=https://api.deepseek.com/v1
MODEL_RUNTIME_ENABLED=false
