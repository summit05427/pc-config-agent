# =========================================================
# 环境变量示例文件：可提交到仓库，不含任何真实密钥
# 使用方式：复制为 .env（.env 已被 .gitignore 忽略）
# 命名约定：嵌套配置用双下划线分隔，如 LLM__MODEL -> settings.llm.model
# =========================================================

# ---------- 应用基础 ----------
APP_NAME=agent-service
# dev / staging / prod
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1
# 列表类型必须是合法 JSON 数组，不能写成逗号分隔
CORS_ORIGINS=["http://localhost:5273","http://127.0.0.1:5273"]

# ---------- 大模型（统一经 LiteLLM 网关） ----------
LLM__MODEL=deepseek:deepseek-v4-pro
LLM__GATEWAY_BASE_URL=http://127.0.0.1:14000
LLM__GATEWAY_API_KEY=sk-replace-with-strong-litellm-master-key
# 直连模式（无网关的 Solo 部署）才使用下面两项；网关模式和直连模式互斥
LLM__API_KEY=sk-replace-with-your-real-key
LLM__BASE_URL=https://api.deepseek.com/v1
LLM__TEMPERATURE=0.7
LLM__MAX_TOKENS=2048
LLM__TIMEOUT_SECONDS=60

# ---------- 模型运行时（Agent -> Java 控制面） ----------
# 关闭时保持原有单模型逻辑，不发起任何控制面出站请求
MODEL_RUNTIME__ENABLED=false
# 容器内用 Compose 服务名；本地开发改为 http://127.0.0.1:18080
CONTROL_PLANE__BASE_URL=http://127.0.0.1:18080
# 服务令牌凭据：CLIENT_ID / CLIENT_SECRET 必须与 Java 的
# INTERNAL_AUTH_CLIENT_ID / INTERNAL_AUTH_CLIENT_SECRET 完全一致，
# 否则 /internal/v1/auth/service-token 会返回 401；secret 由两端同一环境变量注入
CONTROL_PLANE__CLIENT_ID=agent-service
CONTROL_PLANE__CLIENT_SECRET=replace-with-strong-internal-client-secret
# 控制面单次调用超时（秒）；超时按「控制面不可达」处理
CONTROL_PLANE__TIMEOUT_SECONDS=5

# ---------- 鉴权 ----------
# Agent 只持公钥验签：签名私钥只存在于 Java 侧，禁止把私钥放进本服务
# 生成方式（Java 侧）：openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
#                      openssl rsa -pubout -in private.pem -out public.pem
# 单行写入时把换行写成字面量 \n，服务启动时会还原成真实换行
AUTH__JWT_PUBLIC_KEY=replace-with-the-rsa-public-key-pem
# 只允许 RS256，不提供 HS256 兼容开关
AUTH__JWT_ALGORITHM=RS256
# 必须与 Java 签发 header 里的 kid 一致；Java 默认值即 rsa-2026-10
AUTH__JWT_KID=rsa-2026-10
# 必须与 Java 签发方一致，否则所有令牌都会被判定为无效
AUTH__ISSUER=agent-application-service
# 必填且强制校验，必须是 Java 写入 aud 的同一个值
AUTH__AUDIENCE=agent-clients
# dev 专用自签私钥：仅 APP_ENV=dev 且 DEBUG=true 时生效，生产禁止注入
# AUTH__DEV_PRIVATE_KEY=
AUTH__DEV_KID=rsa-dev
AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- 会话持久化 ----------
# memory: 仅测试用，重启即丢；postgres: 生产必须
STORAGE__BACKEND=postgres
# 独立库更安全，避免与业务表混在一起
# 本文件用于宿主机本地开发：pgvector 在宿主映射 15433；容器内由 compose 注入 pgvector:5432
STORAGE__POSTGRES_URL=postgresql://user:password@127.0.0.1:15433/agent_service
# 连接池上限，需与数据库 max_connections 一起评估
STORAGE__POOL_SIZE=5
# 启动时自动建表（幂等）；生产无 DDL 权限时改为 false 并执行迁移
STORAGE__AUTO_SETUP=true

# ---------- Redis（通用基础设施） ----------
# 未配置时 Redis 能力关闭，健康检查返回 redis=disabled
# 配置后建议同时把 REQUIRED 设为 true：连接失败直接拒绝启动，避免带病运行
# 密码含 @ : / 等特殊字符时必须 URL 编码，否则连接串无法正确解析
# REDIS__URL=redis://:password@127.0.0.1:16379/0
REDIS__REQUIRED=false
REDIS__MAX_CONNECTIONS=10
REDIS__SOCKET_TIMEOUT_SECONDS=2
REDIS__CONNECT_TIMEOUT_SECONDS=2
REDIS__HEALTH_CHECK_INTERVAL_SECONDS=30
# 所有 key 统一加此前缀，避免与共享实例中的其他服务冲突
REDIS__KEY_PREFIX=agent
# 缓存类 key 的默认过期秒数，禁止写入无 TTL 的临时数据
REDIS__DEFAULT_TTL_SECONDS=300
# 分布式锁默认持有时间，必须大于临界区耗时
REDIS__LOCK_TTL_SECONDS=30
# 幂等记录的默认保留时间，调用方可按接口覆盖
REDIS__IDEMPOTENCY_TTL_SECONDS=86400

# ---------- Agent 运行时稳定性 ----------
# 传给模型的上下文预算（token），超出后按完整消息单元从旧到新裁剪
AGENT__CONTEXT_MAX_TOKENS=6000
# ReAct 循环上限，防止工具调用死循环
AGENT__RECURSION_LIMIT=12
# 单次对话流总超时（秒），超时下发 error 事件
AGENT__REQUEST_TIMEOUT_SECONDS=120
# 同一会话串行化：锁持有时间必须大于最长生成耗时
AGENT__THREAD_LOCK_TTL_SECONDS=300
# 抢锁等待窗口（秒），0 表示立即返回 409
AGENT__THREAD_LOCK_WAIT_SECONDS=3
# SSE 心跳间隔（秒），模型长时间无输出时下发注释行保活
AGENT__SSE_HEARTBEAT_SECONDS=15

# ---------- Agent 核心能力 ----------
# 系统提示词文件名（app/agent/prompts 目录下，不含 .md），切换人格与规则
AGENT__SYSTEM_PROMPT=pc-config-system
# 工具默认超时（秒），单个工具注册时可覆盖；超时后按安全文案返回
AGENT__TOOL_TIMEOUT_SECONDS=10
# 工具失败后的重试次数，0 表示不重试
AGENT__TOOL_MAX_RETRIES=1
# 工具单次返回的 token 上限，超出后截断并附加「已截断」提示
AGENT__TOOL_MAX_OUTPUT_TOKENS=2000
# 同一工具在一轮对话内的调用上限，超限返回提示文本而非抛错
AGENT__TOOL_MAX_CALLS_PER_TURN=3
# 工具返回给模型前是否脱敏（手机号、邮箱、身份证、API Key / Bearer 凭据）
AGENT__TOOL_REDACT_OUTPUT=true
# 兼容性校验失败后最多自动重新求解的次数（0 表示不重试）
AGENT__MAX_SOLVE_RETRIES=1
# 追加的工具模块（点分路径，逗号分隔）；内置 app.agent.pc.tools 与 app/agent/tools_ext 无需声明
# AGENT__TOOL_MODULES=my_project.tools,my_project.more_tools
# 追加的钩子模块（点分路径，逗号分隔）；为空表示不启用任何生命周期钩子
# AGENT__HOOKS_MODULES=my_project.hooks
# 长会话摘要（默认关闭）：历史超过阈值时压缩早期消息，摘要只影响本次模型输入、不落库
AGENT__SUMMARY_ENABLED=false
AGENT__SUMMARY_TRIGGER_TOKENS=5000
# Agent Profile 配置目录；相对路径按服务根目录解析，子目录中的 YAML 也会加载
AGENT__PROFILES_DIR=app/agents
# 请求未携带 agent_id 时使用的 Profile
AGENT__DEFAULT_PROFILE=pc-config
# 【已废弃 2026-10-29】会话列表改为读取 Postgres 的 session_meta，这两项不再生效；
# 仅保留键名兼容旧部署，后续版本删除
AGENT__SESSION_INDEX_TTL_SECONDS=2592000
AGENT__SESSION_INDEX_MAX=100

# ---------- HITL（人在回路，默认关闭） ----------
# 开启后 PC 配置流水线在缺关键槽位或兼容性无法确认时暂停提问；
# 必须同时使用 postgres 后端，memory 后端不保存中断，开启即拒绝启动
HITL__ENABLED=false
# 中断有效期（秒，1-86400）；超时后恢复请求返回 interrupt_expired
HITL__INTERRUPT_TTL_SECONDS=1800

# ---------- 生成式 UI（OpenUI） ----------
# 与前端 VITE_OPENUI_ENABLED 必须同步开启；开启后把组件契约注入系统提示词
OPENUI__ENABLED=false
# 组件契约文件名（app/agent/prompts 下，不含 .md），由 frontend 的 openui:prompt 生成
OPENUI__PROMPT_NAME=openui
# 单次回答的顶层 UI 块上限（1-10），写入提示词约束输出规模
OPENUI__MAX_BLOCKS=4

# ---------- MCP 接入（可选，默认关闭） ----------
# 仅支持网关拓扑：MCP Server 清单在 deploy/litellm/config.yaml 的 mcp_servers，
# Agent 只连聚合端点；Solo 模式没有网关，因此不提供 MCP。
# 关闭时不导入 MCP SDK、不实例化连接、不发起任何出站请求
MCP__ENABLED=false
# 留空则由 LLM__GATEWAY_BASE_URL + /mcp 推导（容器内 http://litellm:4000/mcp）
MCP__GATEWAY_URL=
# 只接入列出的工具（网关返回的原始工具名，JSON 数组）；为空表示全部接入
MCP__ALLOWED_TOOLS=[]
# 建连 + initialize + tools/list 的总超时（秒）
MCP__CONNECT_TIMEOUT_SECONDS=10
# 单次 MCP 工具调用超时（秒），作为治理超时传给注册表；
# 必须大于 LiteLLM 侧 mcp_servers.<name>.timeout，让网关先超时、Agent 再决定重试
MCP__REQUEST_TIMEOUT_SECONDS=30

# ---------- 可选 RAG（默认关闭） ----------
# 关闭时不导入检索器模块、不发请求，行为与接入前一致
RAG__ENABLED=false
# 检索器模块点分路径，模块内必须暴露 create_retriever()；开启时为空会拒绝启动
RAG__RETRIEVER_MODULE=
# 单轮检索返回的引用条数上限（1-20）
RAG__TOP_K=5

# ---------- 输入侧护栏（默认开启） ----------
# 在进入模型之前拦截超长、控制字符、零宽字符与高置信度提示词注入；
# 命中直接返回 422 input_rejected，不会占用会话锁与限流配额
GUARD__ENABLED=true
# 与 ChatRequest.message 长度上限对齐（1-20000），调小可进一步收紧
GUARD__MAX_INPUT_CHARS=4000
# 关闭后只保留长度与字符类校验，疑似注入的内容放行（仅用于灰度对比）
GUARD__BLOCK_ON_INJECTION=true

# ---------- 对话限流（默认开启） ----------
# 按登录用户做 Redis 固定窗口计数；chat_per_minute=0 表示只保留配置位、不计数
RATE_LIMIT__ENABLED=true
RATE_LIMIT__CHAT_PER_MINUTE=20
# 窗口长度（秒，10-3600）；默认 60 秒即「每分钟 N 次」
RATE_LIMIT__WINDOW_SECONDS=60
# Redis 不可用时是否放行：true 表示降级放行（fail-open），生产严格限流改为 false
RATE_LIMIT__FAIL_OPEN=true

# ---------- 可观测 ----------
# Prometheus 指标开关；端点路径为 {API_PREFIX}/metrics，生产由 Nginx 白名单限制为内网访问
METRICS__ENABLED=true
# 应用内兜底令牌：设置后 /metrics 必须带 X-Metrics-Token；主防线仍是 Nginx 白名单
# METRICS__TOKEN=
# LangSmith 追踪：默认关闭。开启后完整对话、提示词与工具参数会上报到第三方，
# 涉及敏感数据时请改用自托管 OTel 或自托管 LangSmith。
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=agent
# LANGSMITH_ENDPOINT=
